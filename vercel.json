{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    {
      "source": "/noticia/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|WhatsApp|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Applebot|Googlebot|Bingbot|redditbot|Pinterest|vkShare|DuckDuckBot|W3C_Validator).*"
        }
      ],
      "destination": "/api/share/:slug"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
