VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Usadas pelas funções serverless (api/sitemap.xml.js, api/track.js), sem
# prefixo VITE_ porque rodam no servidor (Vercel), não no navegador.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SITE_URL=https://your-domain.vercel.app

# Sal usado por api/track.js para gerar o hash diário de "visitante único"
# (analytics) sem nunca guardar IP. Qualquer string aleatória longa serve —
# depois de definida em produção, não troque (trocar reinicia a contagem de
# visitantes únicos do dia).
ANALYTICS_SALT=
