VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# URL do stream de áudio ao vivo (Shoutcast/Icecast/Centova) usada pelo
# mini-player flutuante da rádio.
VITE_RADIO_STREAM_URL=https://your-stream-provider.example.com:8000/;

# Usadas pelas funções serverless (api/sitemap.xml.js, api/track.js,
# api/share/[slug].js), sem prefixo VITE_ porque rodam no servidor (Vercel),
# não no navegador. Precisam ser cadastradas em Project Settings >
# Environment Variables no Vercel — este arquivo é só para rodar localmente.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Domínio de produção sem barra no final (usado no sitemap, na classificação
# de tráfego "Direto" e no HTML pré-renderizado para bots de redes sociais).
SITE_URL=https://difusorahd.com.br

# Sal usado por api/track.js para gerar o hash diário de "visitante único"
# (analytics) sem nunca guardar IP. Qualquer string aleatória longa serve —
# depois de definida em produção, não troque (trocar reinicia a contagem de
# visitantes únicos do dia).
ANALYTICS_SALT=
